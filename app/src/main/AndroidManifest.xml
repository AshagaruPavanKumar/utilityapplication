<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UtilityApplication"
        tools:targetApi="31">

        <activity
            android:name=".com.feature.home.pres.ui.act.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.UtilityApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".com.feature.everday.pres.ui.act.UnitConverterActivity"
            android:name="com.utilityapplication.com.feature.everday.pres.ui.act.UnitConverterActivity"
            android:exported="false"
            android:label="@string/unit_converter_title"
            android:theme="@style/Theme.UtilityApplication" />
        <activity
            android:name="com.utilityapplication.com.feature.everday.pres.ui.act.RandomToolsActivity"
            android:exported="false"
            android:label="@string/random_tool_title"
            android:theme="@style/Theme.UtilityApplication" />
        <activity
            android:name=".com.feature.everday.pres.ui.act.AgeCalculatorActivity"
            android:exported="false"
            android:label="@string/age_calculator_title"
            android:theme="@style/Theme.UtilityApplication" />
    </application>

</manifest>